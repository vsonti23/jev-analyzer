{
  "manifest_version": 3,
  "name": "Job Sieve",
  "version": "0.1.0",
  "description": "Filter job listings by profile fit, freshness, and sponsorship policy.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*"],
  "action": {
    "default_title": "Job Sieve",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://*.greenhouse.io/*", "https://jobs.lever.co/*"],
      "js": ["dist/content-script.js"],
      "css": ["src/content/badges.css"],
      "run_at": "document_idle"
    }
  ]
}
